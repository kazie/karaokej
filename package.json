{
  "name": "karaokej",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "build": "vue-tsc -b && vite build && tsdown",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "vite",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "start": "node dist-server/index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@noble/ciphers": "^2.4.0",
    "hono": "^4.13.13",
    "uqr": "^0.1.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/fluent": "^1.2.59",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "histoire": "1.0.0-beta.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
