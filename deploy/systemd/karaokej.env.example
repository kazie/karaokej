# Copy to ~/.config/karaokej/karaokej.env

# Container image to run (build it with: podman build -t localhost/karaokej .)
KARAOKEJ_IMAGE=localhost/karaokej:latest

# Folder on this machine that contains your .kfn files (mounted read-only).
KARAOKEJ_LIBRARY_HOST=/srv/karaoke

# Port on this machine.
KARAOKEJ_PORT=3000

# URL phones should open, shown as a QR code on the screen. Use this machine's
# LAN address or hostname; the container cannot detect it by itself.
KARAOKEJ_PUBLIC_URL=http://karaoke.lan:3000

# Re-index the library every N minutes (0 = only at startup and on demand).
KARAOKEJ_RESCAN_MINUTES=60
